{
  "manifest_version": 3,
  "name": "Ezek Tasy",
  "description": "Personaliza o Tasy HTML e mostra metadados técnicos dos campos.",
  "version": "0.1.0",
  "homepage_url": "https://github.com/scripteros/ezekTasy",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "assets/ezek-icon-16.png",
    "32": "assets/ezek-icon-32.png",
    "48": "assets/ezek-icon-48.png",
    "128": "assets/ezek-icon-128.png"
  },
  "action": {
    "default_title": "Ezek Tasy",
    "default_icon": {
      "16": "assets/ezek-icon-16.png",
      "32": "assets/ezek-icon-32.png",
      "48": "assets/ezek-icon-48.png",
      "128": "assets/ezek-icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tasy.sepaco.org.br/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
